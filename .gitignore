# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.env
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# Node / Frontend
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Secrets — NEVER commit these
*.key
*.pem
*.p12
secrets/

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Encrypted document storage — never commit user files
.pmi-agent/

# Alembic env overrides
backend/migrations/versions/*.pyc

# Tauri build output
frontend/src-tauri/target/

# Installer output (compiled .exe — distribute separately)
installer/Output/

# Tauri
desktop/target/
desktop/src-tauri/target/

# Logs
*.log
logs/

# AI-generated files — keep directory but not contents
backend/generated_files/*
!backend/generated_files/.gitkeep

# Database dumps
*.sql.gz
*.dump

# Alembic (keep versions/, not __pycache__)
backend/migrations/__pycache__/
backend/google_token.json 
backend/google_credentials.json

# Code-signing private key — NEVER commit. Public .cer is safe to share.
*.pfx
installer/cert/LittleGerry-Signing.pfx

# Auto-update token — read-only GitHub PAT baked into installers at build time.
# NEVER commit. Lives only on the build machine and inside built installers.
update_token.txt

# Local-only helper scripts that contain baked-in secrets (e.g. the macOS
# token installer handed to teammates privately). NEVER commit.
local/
