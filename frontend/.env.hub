# Same-origin build for the shared hub. Empty API base yields relative URLs,
# which keeps the IAP session cookie attached. VITE_WS_BASE is set at build
# time from brand/brand.json hub_url (vite.config.ts); this value is PMI's
# fallback for a build with no brand file.
VITE_API_BASE=
VITE_WS_BASE=wss://hub.precisianmedical.com
