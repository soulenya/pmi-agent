# PMI Agent — Environment Variables
# Copy this to .env and fill in values.
# Secrets (JWT, Fernet key, API keys) are stored in OS keyring — NOT here.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pmi_app:pmi_dev_password@localhost:5432/pmi_dev
DATABASE_URL_SYNC=postgresql://pmi_app:pmi_dev_password@localhost:5432/pmi_dev

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=false

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=llama3.2
DEFAULT_EMBEDDING_MODEL=nomic-embed-text

# ─── RAG ──────────────────────────────────────────────────────────────────────
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RAG_TOP_K=5

# ─── Approval ────────────────────────────────────────────────────────────────
APPROVAL_EXPIRY_HOURS=48

# NOTE: The following are stored in OS keyring (not .env):
#   jwt_secret        — auto-generated on first run
#   fernet_key        — auto-generated on first run
#   openai_api_key    — set via Settings UI
#   anthropic_api_key — set via Settings UI
#   tavily_api_key    — set via Settings UI
