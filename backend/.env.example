# PMI Agent — Environment Variables
# Copy this to .env and fill in values.
# Secrets (JWT, Fernet key, API keys) are stored in OS keyring — NOT here.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pmi:pmi_dev_password@localhost:5432/pmi_dev
DATABASE_URL_SYNC=postgresql://pmi:pmi_dev_password@localhost:5432/pmi_dev

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=false

# ─── Ollama ───────────────────────────────────────────────────────────────────
# Ollama is optional — only needed if using Ollama as LLM or embedding provider
OLLAMA_BASE_URL=http://localhost:11434

# ─── AI Providers (default: Anthropic + Voyage AI) ───────────────────────────
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-sonnet-4-6
DEFAULT_EMBEDDING_PROVIDER=voyage
DEFAULT_EMBEDDING_MODEL=voyage-3
DEFAULT_EMBEDDING_DIMENSION=1024

# ─── RAG ──────────────────────────────────────────────────────────────────────
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RAG_TOP_K=5

# ─── Approval ────────────────────────────────────────────────────────────────
APPROVAL_EXPIRY_HOURS=48

# NOTE: The following are stored in OS keyring (not .env) — set via Settings UI:
#   jwt_secret            — auto-generated on first run
#   fernet_key            — auto-generated on first run
#   anthropic_api_key     — Settings → AI Engine → Anthropic API Key
#   voyage_api_key        — Settings → AI Engine → Voyage AI API Key
#   openai_api_key        — Settings → AI Engine → OpenAI API Key (if using OpenAI)
